<?xml version="1.0" encoding="utf-8"?>
<!--
    Símbolo de la marca NEOSICHER: "ojo/lente" estilizado (la O del logotipo)
    con un párpado curvo encima, en azul claro de la paleta NEOSICHER.
    Recreación vectorial propia inspirada en el logo proporcionado.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Párpado / ceja curva superior -->
    <path
        android:strokeColor="#A9CFF5"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M14,17 Q24,8 34,17" />

    <!-- Anillo exterior del ojo/lente -->
    <path
        android:strokeColor="#A9CFF5"
        android:strokeWidth="3"
        android:fillColor="#00000000"
        android:pathData="M24,20 m-11,0 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0" />

    <!-- Pupila / detalle central -->
    <path
        android:fillColor="#A9CFF5"
        android:pathData="M24,31 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0" />

    <!-- Pequeña cola/curva estilo "lente" dentro de la pupila -->
    <path
        android:strokeColor="#1B2A44"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M24,31 L26.4,33.4" />
</vector>
